# ============================================================
# ASEMON-PG : paramètres des scripts d'installation
# Copier ce fichier en scripts/asemon.env, adapter, puis lancer :
#   sudo ./scripts/install-monitoring.sh     (sur VM-Monitoring)
#   sudo ./scripts/install-target.sh         (sur VM-Cible)
# asemon.env contient des mots de passe : il n'est PAS versionné (.gitignore).
# Le même fichier peut servir sur les deux VM.
#
# Mots de passe : lettres, chiffres et . _ @ % + = - uniquement (8 caractères
# minimum). Pas d'espace, d'apostrophe ni de guillemet : ils sont recopiés
# tels quels dans des chaînes de connexion.
# ============================================================

# --- Communs -------------------------------------------------
PG_VERSION=17                       # version majeure de PostgreSQL (dépôt PGDG)
SUBNET=192.168.1.0/24               # réseau autorisé à joindre le repository
MONITORING_IP=192.168.1.28          # IP de VM-Monitoring
COLLECTOR_PASSWORD=CHANGEME_collector      # rôle collector_writer (écrit dans le repository)
ASEMON_COLLECT_PASSWORD=CHANGEME_asemon_collect  # rôle asemon_collect (lit l'instance surveillée)

# --- VM-Monitoring uniquement ---------------------------------
GRAFANA_RO_PASSWORD=CHANGEME_grafana       # rôle grafana_ro (lecture seule, pour Grafana)
GRAFANA_ADMIN_PASSWORD=                    # vide = ne pas toucher au compte admin ni importer
                                           # les dashboards ; renseigné = mot de passe admin
                                           # voulu (changé depuis admin/admin si besoin)
POSTGRES_PASSWORD=                         # vide = laisser le mot de passe du superuser tel quel

# --- VM-Cible uniquement --------------------------------------
SERVICE_USER=admin01                # compte Linux qui fait tourner le collecteur et l'échantillonneur
INSTALL_DIR=/opt/asemon             # dossier de l'application
INTERVAL=15                         # secondes entre deux snapshots (collector)
SAMPLE_INTERVAL=2                   # secondes entre deux échantillons (sampler, 0.5 à 60)
TARGET_ALLOW_SUBNET=                # vide = l'instance n'écoute qu'en local (suffisant) ;
                                    # sinon ex. 192.168.1.0/24 : ouvre le port 5432 à ce réseau
