# ============================================================
# monAp_pg : paramètres des scripts d'installation
# Copier ce fichier en scripts/asemon.env, adapter, puis lancer :
#   sudo ./scripts/install-monitoring.sh     (sur VM-Monitoring)
#   sudo ./scripts/install-target.sh         (sur VM-Cible)
# asemon.env contient des mots de passe : il n'est PAS versionné (.gitignore).
# Le même fichier peut servir sur les deux VM.
#
# Mots de passe : lettres, chiffres et . _ @ % + = - uniquement (8 caractères
# minimum). Pas d'espace, d'apostrophe ni de guillemet : ils sont recopiés
# tels quels dans des chaînes de connexion.
# ============================================================

# ============================================================
# 1. COMPTES ET MOTS DE PASSE  (à relire en premier)
# ============================================================
# Les noms de compte (logins) sont fixes : ils sont écrits dans les scripts SQL,
# le pg_hba.conf et la datasource Grafana. Seuls les mots de passe se choisissent.
#
#   Login (fixe)       Où                 Rôle                                  Mot de passe
#   collector_writer   VM-Monitoring      écrit dans le repository              COLLECTOR_PASSWORD
#   grafana_ro         VM-Monitoring      lecture seule, pour Grafana           GRAFANA_RO_PASSWORD
#   asemon_collect     VM-Cible           lit l'instance surveillée             ASEMON_COLLECT_PASSWORD
#   admin (Grafana)    VM-Monitoring      administrateur de l'interface Grafana GRAFANA_ADMIN_PASSWORD
#   postgres           les deux           superuser PostgreSQL                  POSTGRES_PASSWORD
#   SERVICE_USER       VM-Cible           compte Linux qui exécute les services (pas de mot de passe ici)
#
# ATTENTION si le POC est DÉJÀ installé : mettre ici les mots de passe déjà en
# service (REPO_DSN et TARGET_DSN dans /opt/asemon/app/config.py), sinon la
# collecte s'arrête. Pour changer un mot de passe, relancer les DEUX scripts
# avec FORCE_CONFIG=1 sur VM-Cible.

COLLECTOR_PASSWORD=CHANGEME_collector            # collector_writer
GRAFANA_RO_PASSWORD=CHANGEME_grafana             # grafana_ro
ASEMON_COLLECT_PASSWORD=CHANGEME_asemon_collect  # asemon_collect
GRAFANA_ADMIN_PASSWORD=                          # vide = ne pas toucher au compte admin ni importer
                                                 # les dashboards ; renseigné = mot de passe admin
                                                 # voulu (changé depuis admin/admin si besoin)
POSTGRES_PASSWORD=                               # vide = laisser le mot de passe du superuser tel quel
SERVICE_USER=admin01                             # compte Linux des services (VM-Cible)

# ============================================================
# 2. RÉSEAU ET VERSION
# ============================================================
PG_VERSION=17                       # version majeure de PostgreSQL (dépôt PGDG)
SUBNET=192.168.1.0/24               # réseau autorisé à joindre le repository
MONITORING_IP=192.168.1.28          # IP de VM-Monitoring

# ============================================================
# 3. VM-Cible : application
# ============================================================
INSTALL_DIR=/opt/asemon             # dossier de l'application
INSTANCE_NAME=VM-Cible               # nom de CETTE machine dans les dashboards (unique ; lettres, chiffres, . _ -)
INTERVAL=15                         # secondes entre deux snapshots (collector)
SAMPLE_INTERVAL=2                   # secondes entre deux échantillons (sampler, 0.5 à 60)
TARGET_ALLOW_SUBNET=                # vide = l'instance n'écoute qu'en local (suffisant) ;
                                    # sinon ex. 192.168.1.0/24 : ouvre le port 5432 à ce réseau
