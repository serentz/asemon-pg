{
  "__inputs": [
    {
      "name": "DS_MONITORING",
      "label": "ASEMON Monitoring (PostgreSQL)",
      "description": "Datasource PostgreSQL pointant sur la base 'monitoring' (schéma asemon), configurée sur VM-Monitoring.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "ASEMON-PG — Détail d'une requête",
  "uid": "asemon-query",
  "description": "Détail d'une requête : texte, coûts, sessions qui l'ont exécutée et plans. S'ouvre depuis la page Micro (variable query_id).",
  "tags": [
    "asemon",
    "postgresql",
    "micro",
    "detail"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Macro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-macro",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Intermédiaire",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-intermediate",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Micro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-micro",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_MONITORING",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "label": "Datasource ASEMON"
      },
      {
        "name": "query_id",
        "label": "query_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requête",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Texte SQL",
      "description": "Texte normalisé de pg_stat_statements (paramètres remplacés par $1, $2...). Vide si la requête n'a jamais figuré dans le top relevé par le collecteur.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT query AS \"Requête\" FROM asemon.snap_statements WHERE queryid = ${query_id:sqlstring}::bigint ORDER BY collected_at DESC LIMIT 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Temps actif (période)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT sum(sm.interval_ms) / 1000.0 AS \"Temps actif\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "dont CPU",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event IS NULL), 0) / 1000.0 AS \"CPU\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "dont I/O",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event_type = 'IO'), 0) / 1000.0 AS \"I/O\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "dont verrous",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event_type IN ('Lock', 'LWLock')), 0) / 1000.0 AS \"Verrous\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Appels (cumul serveur)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT calls AS \"Appels\" FROM asemon.snap_statements WHERE queryid = ${query_id:sqlstring}::bigint ORDER BY collected_at DESC LIMIT 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Temps moyen (cumul serveur)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT mean_exec_time AS \"Temps moyen\" FROM asemon.snap_statements WHERE queryid = ${query_id:sqlstring}::bigint ORDER BY collected_at DESC LIMIT 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Charge de la requête par type d'attente (par minute)",
      "description": "Temps actif de cette requête, tous sessions confondues. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', sm.sampled_at) AS \"time\", CASE WHEN sm.wait_event IS NULL THEN 'CPU' ELSE sm.wait_event_type END AS \"metric\", SUM(sm.interval_ms) / 60000.0 AS \"Sessions actives\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint GROUP BY 1, 2 ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Temps moyen d'exécution (pg_stat_statements)",
      "description": "Évolution du temps moyen cumulé depuis le dernier reset des statistiques.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", mean_exec_time AS \"Temps moyen\" FROM asemon.snap_statements WHERE $__timeFilter(collected_at) AND queryid = ${query_id:sqlstring}::bigint ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Sessions qui ont exécuté cette requête (cliquer sur une session_key pour la retrouver)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Sessions",
      "description": "Sessions ayant exécuté la requête sur la période, par temps actif décroissant. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Temps actif"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session_key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Détail de la session",
                    "url": "/d/asemon-session?var-session_key=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Première vue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dernière vue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT sm.session_key AS \"session_key\", max(sm.usename) AS \"Login\", max(sm.application_name) AS \"Programme\", round(sum(sm.interval_ms) / 1000.0, 1) AS \"Temps actif\", count(DISTINCT sm.query_start) AS \"Exécutions relevées\", min(sm.sampled_at) AS \"Première vue\", max(sm.sampled_at) AS \"Dernière vue\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.query_id = ${query_id:sqlstring}::bigint GROUP BY sm.session_key ORDER BY sum(sm.interval_ms) DESC LIMIT 50",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Plans d'exécution capturés",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Plans (auto_explain)",
      "description": "Plans de cette requête, tous sessions confondues, liés par query_id. Les plans enregistrés avant la mise en place de la colonne query_id n'apparaissent pas.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Durée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quand"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session_key"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Détail de la session",
                    "url": "/d/asemon-session?var-session_key=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT occurred_at AS \"Quand\", duration_ms AS \"Durée\", session_key AS \"session_key\", plan AS \"Plan\" FROM asemon.event_plans WHERE query_id = ${query_id:sqlstring}::bigint ORDER BY occurred_at DESC LIMIT 50",
          "rawQuery": true
        }
      ]
    }
  ]
}
