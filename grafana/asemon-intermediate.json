{
  "__inputs": [
    {
      "name": "DS_MONITORING",
      "label": "ASEMON Monitoring (PostgreSQL)",
      "description": "Datasource PostgreSQL pointant sur la base 'monitoring' (schéma asemon), configurée sur VM-Monitoring.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "ASEMON-PG — Intermédiaire",
  "uid": "asemon-intermediate",
  "description": "Page 2 de l'IHM ASEMON-PG : répartition de la charge active par login et programme, graphiques système, connexions, checkpoints et WAL.",
  "tags": [
    "asemon",
    "postgresql",
    "intermediaire"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Macro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-macro",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Intermédiaire",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-intermediate",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_MONITORING",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "label": "Datasource ASEMON"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Répartition de la charge active sur la période (temps actif échantillonné)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Temps actif par login",
      "description": "Qui consomme du temps de base de données. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact. Les sessions de ASEMON-PG (application_name asemon-*) sont exclues.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Secondes actives$/",
          "values": true
        },
        "pieType": "pie",
        "displayLabels": [
          "percent"
        ],
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(NULLIF(usename, ''), '(inconnu)') AS \"Login\", SUM(interval_ms) / 1000.0 AS \"Secondes actives\" FROM asemon.snap_samples WHERE $__timeFilter(sampled_at) AND application_name NOT LIKE 'asemon-%' GROUP BY 1 ORDER BY 2 DESC",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Temps actif par programme",
      "description": "Quelle application (application_name) consomme du temps. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact. Les sessions de ASEMON-PG (application_name asemon-*) sont exclues.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Secondes actives$/",
          "values": true
        },
        "pieType": "pie",
        "displayLabels": [
          "percent"
        ],
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(NULLIF(application_name, ''), '(sans nom)') AS \"Programme\", SUM(interval_ms) / 1000.0 AS \"Secondes actives\" FROM asemon.snap_samples WHERE $__timeFilter(sampled_at) AND application_name NOT LIKE 'asemon-%' GROUP BY 1 ORDER BY 2 DESC",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "CPU contre attentes",
      "description": "CPU = session active sans attente ; sinon type d'attente (IO, Lock, LWLock, Client...). Approximation, la mesure réelle viendra de pg_stat_kcache. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact. Les sessions de ASEMON-PG (application_name asemon-*) sont exclues.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Secondes actives$/",
          "values": true
        },
        "pieType": "pie",
        "displayLabels": [
          "percent"
        ],
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT CASE WHEN wait_event IS NULL THEN 'CPU' ELSE wait_event_type END AS \"Type\", SUM(interval_ms) / 1000.0 AS \"Secondes actives\" FROM asemon.snap_samples WHERE $__timeFilter(sampled_at) AND application_name NOT LIKE 'asemon-%' GROUP BY 1 ORDER BY 2 DESC",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Charge active par type d'attente (sessions actives moyennes par minute)",
      "description": "Équivalent d'un graphique ASH : hauteur = nombre moyen de sessions actives, couleur = ce qu'elles font (CPU ou type d'attente). Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact. Les sessions de ASEMON-PG (application_name asemon-*) sont exclues.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', sampled_at) AS \"time\", CASE WHEN wait_event IS NULL THEN 'CPU' ELSE wait_event_type END AS \"metric\", SUM(interval_ms) / 60000.0 AS \"Sessions actives\" FROM asemon.snap_samples WHERE $__timeFilter(sampled_at) AND application_name NOT LIKE 'asemon-%' GROUP BY 1, 2 ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Système",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU / Mémoire / iowait",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", cpu_percent AS \"CPU %\", mem_percent AS \"Mémoire %\", cpu_iowait_percent AS \"iowait %\" FROM asemon.snap_os WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Réseau (delta / cycle de collecte)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", net_sent_bytes AS \"Envoyé\", net_recv_bytes AS \"Reçu\" FROM asemon.snap_os WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Espace disque libre",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT disk_free_bytes AS \"Libre\", disk_total_bytes AS \"Total\" FROM asemon.snap_os ORDER BY collected_at DESC LIMIT 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cache hit ratio (cible > 99% en OLTP)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 90,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", (SUM(blks_hit)::float / NULLIF(SUM(blks_hit) + SUM(blks_read), 0)) * 100 AS \"Cache hit ratio\" FROM asemon.snap_io WHERE $__timeFilter(collected_at) GROUP BY collected_at ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Fichiers temporaires (work_mem trop bas ?)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", SUM(temp_files) AS \"Fichiers temp.\", SUM(temp_bytes) AS \"Octets temp.\" FROM asemon.snap_io WHERE $__timeFilter(collected_at) GROUP BY collected_at ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Connexions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Connexions (active / idle / idle in transaction) vs max_connections",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", active_connections AS \"Actives\", idle_connections AS \"Idle\", idle_in_transaction_connections AS \"Idle in transaction\", max_connections AS \"max_connections\" FROM asemon.snap_connections WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Checkpoints et WAL",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Checkpoints planifiés vs demandés (num_requested élevé => max_wal_size trop bas)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", num_timed AS \"Planifiés\", num_requested AS \"Demandés\" FROM asemon.snap_checkpoints WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Volume de WAL généré (cumulé)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", wal_bytes::numeric AS \"WAL (octets cumulés)\" FROM asemon.snap_wal WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    }
  ]
}
