  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "État actuel des indicateurs",
      "description": "Dernière valeur de chaque indicateur (moins de 15 minutes), comparée aux seuils en vigueur. « Pas de mesure » : aucune donnée récente (instance arrêtée, ou aucune activité : verrous, transactions). Un indicateur désactivé n'apparaît pas.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT instance_name AS \"Instance\", label AS \"Indicateur\", unit AS \"Unité\",\n       round(value::numeric, 1) AS \"Valeur\", warn_value AS \"Avertissement\", crit_value AS \"Alarme\",\n       state AS \"État\", value_ts AS \"Mesuré à\"\nFROM asemon.v_kpi_status\nORDER BY instance_name, sort_order"
        }
      ],
