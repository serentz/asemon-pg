                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Seuils en vigueur",
      "description": "Seuils effectivement appliqués à chaque instance : ceux qui lui sont propres, sinon le défaut.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "gridPos": {
        "h": 17,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT i.name AS \"Instance\", c.label AS \"Indicateur\", c.unit AS \"Unité\",\n       COALESCE(o.warn_value, d.warn_value) AS \"Avertissement\",\n       COALESCE(o.crit_value, d.crit_value) AS \"Alarme\",\n       CASE WHEN o.threshold_id IS NOT NULL THEN 'propre à l''instance' ELSE 'défaut' END AS \"Origine\",\n       COALESCE(o.enabled, d.enabled) AS \"Actif\",\n       COALESCE(o.updated_at, d.updated_at) AS \"Modifié le\",\n       COALESCE(o.updated_by, d.updated_by) AS \"Par\"\nFROM asemon.instances i\nCROSS JOIN asemon.kpi_catalog c\nJOIN asemon.kpi_thresholds d ON d.kpi = c.kpi AND d.instance_id IS NULL\nLEFT JOIN asemon.kpi_thresholds o ON o.kpi = c.kpi AND o.instance_id = i.instance_id\nWHERE i.enabled\nORDER BY i.name, c.sort_order"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Indicateur"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
