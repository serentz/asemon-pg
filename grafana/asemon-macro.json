{
  "__inputs": [
    {
      "name": "DS_MONITORING",
      "label": "ASEMON Monitoring (PostgreSQL)",
      "description": "Datasource PostgreSQL pointant sur la base 'monitoring' (schéma asemon), configurée sur VM-Monitoring.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "ASEMON-PG — Macro",
  "uid": "asemon-macro",
  "description": "Page 1 de l'IHM ASEMON-PG : indicateurs instantanés et résumé par heure sur les 6 dernières heures.",
  "tags": [
    "asemon",
    "postgresql",
    "macro"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_MONITORING",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "label": "Datasource ASEMON"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Indicateurs sur la période",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions actives",
      "description": "Sessions en état active à chaque cycle du collecteur (snap_connections). Valeur = dernier cycle.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": true,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", active_connections AS \"Sessions actives\" FROM asemon.snap_connections WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connexions / max_connections",
      "description": "Connexions ouvertes en % de max_connections. Orange au-delà de 70 %, rouge au-delà de 85 %.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", 100.0 * total_connections / NULLIF(max_connections, 0) AS \"Connexions %\" FROM asemon.snap_connections WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU hôte",
      "description": "Charge CPU de la VM surveillée (snap_os).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": true,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", cpu_percent AS \"CPU %\" FROM asemon.snap_os WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mémoire hôte",
      "description": "Mémoire utilisée de la VM surveillée (snap_os).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": true,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT collected_at AS \"time\", mem_percent AS \"Mémoire %\" FROM asemon.snap_os WHERE $__timeFilter(collected_at) ORDER BY collected_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Valeur de la dernière heure (snap_hourly_summary), calculée sur les écarts de compteurs. Cible > 99 % en OLTP.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT hour_bucket AS \"time\", cache_hit_ratio AS \"Cache hit ratio\" FROM asemon.snap_hourly_summary WHERE hour_bucket >= date_trunc('hour', $__timeFrom()::timestamptz) AND hour_bucket <= $__timeTo() ORDER BY hour_bucket",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Deadlocks",
      "description": "Total sur la période affichée, par heures pleines UTC (la première heure peut commencer avant le début de la période).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT hour_bucket AS \"time\", total_deadlocks AS \"Deadlocks\" FROM asemon.snap_hourly_summary WHERE hour_bucket >= date_trunc('hour', $__timeFrom()::timestamptz) AND hour_bucket <= $__timeTo() ORDER BY hour_bucket",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Requêtes lentes",
      "description": "Plans capturés par auto_explain (au-dessus du seuil auto_explain.log_min_duration) sur la période, par heures pleines UTC.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT hour_bucket AS \"time\", total_slow_queries AS \"Requêtes lentes\" FROM asemon.snap_hourly_summary WHERE hour_bucket >= date_trunc('hour', $__timeFrom()::timestamptz) AND hour_bucket <= $__timeTo() ORDER BY hour_bucket",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Charge active moyenne",
      "description": "Nombre moyen de sessions actives par minute, d'après l'échantillonnage toutes les 2 s (snap_samples). Dernière minute = partielle.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', sampled_at) AS \"time\", SUM(interval_ms) / 60000.0 AS \"Sessions actives moy.\" FROM asemon.snap_samples WHERE $__timeFilter(sampled_at) GROUP BY 1 ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Résumé par heure (6 dernières heures, la dernière est partielle)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Une ligne par heure",
      "description": "Source : snap_hourly_summary (heures pleines UTC, affichées dans le fuseau du navigateur), recalculée toutes les 5 minutes. Une heure absente signale un trou de collecte. Indépendant de la période choisie en haut.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mémoire %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sessions moy."
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache hit %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 95
                    },
                    {
                      "color": "green",
                      "value": 99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Deadlocks"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requêtes lentes"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT hour_bucket AS \"Heure\", avg_cpu_percent AS \"CPU %\", avg_mem_percent AS \"Mémoire %\", avg_active_sessions AS \"Sessions moy.\", max_active_sessions AS \"Sessions max\", total_deadlocks AS \"Deadlocks\", total_slow_queries AS \"Requêtes lentes\", cache_hit_ratio AS \"Cache hit %\" FROM asemon.snap_hourly_summary ORDER BY hour_bucket DESC LIMIT 6",
          "rawQuery": true
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Macro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-macro",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Intermédiaire",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-intermediate",
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
