{
  "__inputs": [
    {
      "name": "DS_MONITORING",
      "label": "ASEMON Monitoring (PostgreSQL)",
      "description": "Datasource PostgreSQL pointant sur la base 'monitoring' (schéma asemon), configurée sur VM-Monitoring.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "ASEMON-PG — Détail d'une session",
  "uid": "asemon-session",
  "description": "Détail d'une session : identité, coûts, exécutions, plans et deadlocks. S'ouvre depuis la page Micro (variable session_key).",
  "tags": [
    "asemon",
    "postgresql",
    "micro",
    "detail"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Macro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-macro",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Intermédiaire",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-intermediate",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Micro",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/asemon-micro",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_MONITORING",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "label": "Datasource ASEMON"
      },
      {
        "name": "session_key",
        "label": "session_key",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Session",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Identité de la session",
      "description": "Source : snap_sessions (connexion et déconnexion lues dans les logs). Vide si la session n'a pas été vue dans les logs ou si session_key est vide.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Connexion"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Déconnexion"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT session_key, pid, usename AS \"Login\", application_name AS \"Programme\", datname AS \"Base\", client_addr AS \"Adresse\", connected_at AS \"Connexion\", disconnected_at AS \"Déconnexion\" FROM asemon.snap_sessions WHERE session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Temps actif",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT sum(sm.interval_ms) / 1000.0 AS \"Temps actif\" FROM asemon.snap_samples sm WHERE sm.session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "dont CPU",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event IS NULL), 0) / 1000.0 AS \"CPU\" FROM asemon.snap_samples sm WHERE sm.session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "dont I/O",
      "gridPos": {
