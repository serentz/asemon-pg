          },
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event_type = 'IO'), 0) / 1000.0 AS \"I/O\" FROM asemon.snap_samples sm WHERE sm.session_key = ${session_key:sqlstring}",
          "rawQuery": true
