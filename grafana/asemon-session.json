        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT count(DISTINCT sm.query_id) AS \"Requêtes\" FROM asemon.snap_samples sm WHERE sm.session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "CPU mesuré",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(cpu_ms), 0) / 1000.0 AS \"CPU mesuré\" FROM asemon.kcache_attr($__timeFrom(), $__timeTo()) WHERE session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ],
      "description": "Coût réel mesuré par pg_stat_kcache sur la période du dashboard. Répartition approchée entre les sessions qui exécutent la même requête."
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Lu sur disque",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(reads_bytes), 0)::float8 AS \"Lu\" FROM asemon.kcache_attr($__timeFrom(), $__timeTo()) WHERE session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ],
      "description": "Coût réel mesuré par pg_stat_kcache sur la période du dashboard. Répartition approchée entre les sessions qui exécutent la même requête."
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Écrit sur disque",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
