          },
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(writes_bytes), 0)::float8 AS \"Écrit\" FROM asemon.kcache_attr($__timeFrom(), $__timeTo()) WHERE session_key = ${session_key:sqlstring}",
          "rawQuery": true
        }
      ],
      "description": "Coût réel mesuré par pg_stat_kcache sur la période du dashboard. Répartition approchée entre les sessions qui exécutent la même requête."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Charge de la session par type d'attente (par minute)",
      "description": "Temps actif de cette session, empilé par type d'attente. Temps actif échantillonné (snap_samples, relevé toutes les 2 s), pas un coût CPU exact.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', sm.sampled_at) AS \"time\", CASE WHEN sm.wait_event IS NULL THEN 'CPU' ELSE sm.wait_event_type END AS \"metric\", SUM(sm.interval_ms) / 60000.0 AS \"Sessions actives\" FROM asemon.snap_samples sm WHERE $__timeFilter(sm.sampled_at) AND sm.session_key = ${session_key:sqlstring} GROUP BY 1, 2 ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Requêtes exécutées (une ligne par exécution relevée)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Exécutions",
      "description": "Une ligne = une exécution vue par l'échantillonneur (query_id + query_start). Fin et durée sont approximatives (dernier échantillon + intervalle). Les exécutions plus courtes que l'intervalle peuvent manquer. 200 dernières.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_MONITORING}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Temps actif"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dont CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dont I/O"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dont verrous"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "query_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Détail de la requête",
                    "url": "/d/asemon-query?var-query_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Début"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fin (approx.)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_MONITORING}"
          },
          "format": "table",
          "rawSql": "SELECT sm.query_start AS \"Début\", max(sm.sampled_at) + max(sm.interval_ms) * interval '1 millisecond' AS \"Fin (approx.)\", round(sum(sm.interval_ms) / 1000.0, 1) AS \"Temps actif\", round(COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event IS NULL), 0) / 1000.0, 1) AS \"dont CPU\", round(COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event_type = 'IO'), 0) / 1000.0, 1) AS \"dont I/O\", round(COALESCE(sum(sm.interval_ms) FILTER (WHERE sm.wait_event_type IN ('Lock', 'LWLock')), 0) / 1000.0, 1) AS \"dont verrous\", sm.query_id::text AS \"query_id\", COALESCE((SELECT st.query FROM asemon.snap_statements st WHERE st.queryid = sm.query_id ORDER BY st.collected_at DESC LIMIT 1), '(texte non capturé)') AS \"Requête\" FROM asemon.snap_samples sm WHERE sm.session_key = ${session_key:sqlstring} GROUP BY sm.query_id, sm.query_start ORDER BY sm.query_start DESC NULLS LAST LIMIT 200",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Plans d'exécution et deadlocks de la session",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Plans capturés (auto_explain)",
