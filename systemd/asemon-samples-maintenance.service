[Unit]
Description=ASEMON-PG Maintenance des partitions snap_samples (creation, retention)
After=postgresql.service
Requires=postgresql.service

[Service]
# À installer sur VM-Monitoring, déclenché par asemon-samples-maintenance.timer.
# Tourne sous `postgres` (peer), comme asemon-rollup.
Type=oneshot
User=postgres
ExecStart=/usr/bin/psql -X -q -At -v ON_ERROR_STOP=1 -d monitoring -c "SELECT asemon.maintain_samples();"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=asemon-samples-maintenance
