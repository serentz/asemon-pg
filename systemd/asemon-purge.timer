[Unit]
Description=ASEMON-PG Purge des donnees anciennes, une fois par jour

[Timer]
# 03:17 UTC (05:17 en heure d'été française), hors des pointes d'activité
OnCalendar=*-*-* 03:17:00
# Rattrape un déclenchement manqué (VM éteinte) au démarrage suivant
Persistent=true
Unit=asemon-purge.service

[Install]
WantedBy=timers.target
