[Unit]
Description=ASEMON-PG Retention : purge des donnees anciennes et reduction des points de capacity planning
After=postgresql.service
Requires=postgresql.service

[Service]
# À installer sur VM-Monitoring, déclenché par asemon-retention.timer. Remplace asemon-purge.service.
# Tourne sous `postgres` (connexion locale par socket, authentification peer).
Type=oneshot
User=postgres
ExecStart=/opt/asemon/venv/bin/python3 /opt/asemon/app/retention.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=asemon-retention
